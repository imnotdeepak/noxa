{
  "manifest_version": 3,
  "name": "Noxa Safari Filter",
  "version": "0.2.0",
  "description": "Hides Instagram Reels and Explore, and YouTube Shorts, in Safari.",
  "icons": {
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://www.instagram.com/*",
    "*://instagram.com/*",
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "instagram-filter.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "youtube-filter.js"
      ],
      "run_at": "document_start"
    }
  ]
}
