{
  "manifest_version": 3,
  "name": "Noxa Instagram Filter Prototype",
  "version": "0.1.0",
  "description": "Prototype that hides Instagram Reels and Explore in Safari.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["*://www.instagram.com/*", "*://instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["instagram-filter.js"],
      "run_at": "document_start"
    }
  ]
}
